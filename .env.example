# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_GEAR_COMBINATION_HASH: The SHA-256 hash representing the 3-Gear Combination alignment.
# Defaults to SHA-256 target for "427" if unspecified ("ad8251cf45ccda7c5520e7df65049386d62d294ef3bd6dae360f089196b0bd56").
ADMIN_GEAR_COMBINATION_HASH=""

# FIREBASE_CONFIG: Optional JSON string of the Firebase Web App configuration to persist portfolio database state across ephemeral server environments like Render.
# Copy the contents of firebase-applet-config.json entirely into this variable on your cloud deployment dashboard.
FIREBASE_CONFIG=""

# Cloudinary Integration API credentials
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Vercel Blob Integration (Optional fallback for zero-config uploads on Vercel)
# Vercel automatically injects this as BLOB_READ_WRITE_TOKEN when you connect Vercel Blob Storage.
BLOB_READ_WRITE_TOKEN=""


